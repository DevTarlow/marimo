node_modules/
dist/
*.log

# Install caches, kept inside the repo because this project is developed in an
# environment that only permits writes under the workspace. `.npmrc` points the
# pnpm store and npm's cache here; the XDG_* variables the pnpm wrapper exports
# cover the rest.
.pnpm-store/
.npmcache/
.pnpm-home/
.electron-cache/
.xdg-cache/
.xdg-data/
.xdg-config/
.xdg-state/

# TypeScript incremental build state.
*.tsbuildinfo

# Packaged output. `electron-builder` writes an AppImage and a full unpacked
# tree here — hundreds of megabytes of build product that is reproducible from
# the source beside it.
apps/desktop/release/
.electron-builder-cache/

# Local runtime state produced when running the app outside Electron's
# userData directory. Every dev, smoke and test run uses a throwaway directory
# under this pattern — and so does anything scratch, including screenshots.
#
# Keep it to directories. A loose PNG in the repository root is *not* covered
# by this, and one `git add -A` later it is in the tree — which is how a
# throwaway diagnostic ends up in a release. Put scratch files in a directory
# under this pattern instead.
.marimo*/
